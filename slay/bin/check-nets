#!/usr/bin/env ruby
# Checks the identification nets against the discs this collection actually
# contains. Rails was generated --skip-test, so this is a runnable script
# rather than a spec; it exits non-zero on failure and is meant for CI or a
# quick sanity pass after changing a net.
#
# It boots ActiveSupport and the nets rather than the application. Nothing here
# needs a database, a network or a disc, and requiring the full environment
# meant none of it could be run without Postgres up — on a laptop, or on the
# machine that has no drives attached. Identification being replayable offline
# is the premise the whole catalog is built on; the script that checks it
# should hold to the same standard.
require "active_support"
require "active_support/core_ext/object/blank"

root = File.expand_path("..", __dir__)
Dir[File.join(root, "app/models/identify/*.rb")].sort.each { |f| require f }

$failures = 0
def check(what, got, want)
  ok = got == want
  $failures += 1 unless ok
  puts format("%-4s %-46s %s", ok ? "ok" : "FAIL", what, ok ? got.inspect : "got #{got.inspect}, want #{want.inspect}")
end

# A disc built in memory; nothing is persisted.
Fake = Struct.new(:volume_label, :disc_name, :disc_type, :disc_titles, keyword_init: true)
Title = Struct.new(:duration_seconds)
def fake(label: nil, name: nil, type: "dvd", secs: [])
  Fake.new(volume_label: label, disc_name: name, disc_type: type,
           disc_titles: secs.map { |s| Title.new(s) })
end

label = Identify::LabelNet.new
dname = Identify::DiscNameNet.new
shape = Identify::ShapeNet.new
first = ->(net, d) { net.identify(d).first }

puts "-- LabelNet, on labels from this shelf --"
check("ROMAN_HOLIDAY",       first.(label, fake(label: "ROMAN_HOLIDAY"))&.title, "Roman Holiday")
check("SPACEBALLS_LB drops the letterbox marker",
                             first.(label, fake(label: "SPACEBALLS_LB"))&.title, "Spaceballs")
check("STILL_GAME_S3D2 season", first.(label, fake(label: "STILL_GAME_S3D2"))&.season, 3)
check("STILL_GAME_S3D2 disc",   first.(label, fake(label: "STILL_GAME_S3D2"))&.disc_number, 2)
check("Earthsea kept as typed", first.(label, fake(label: "Earthsea"))&.title, "Earthsea")
check("DVD_VIDEO abstains",     label.identify(fake(label: "DVD_VIDEO")), [])
# STNG must stay weak: a confident wrong expansion cannot be overruled.
stng = first.(label, fake(label: "STNGD3"))
check("STNGD3 is marked an abbreviation", stng.confidence < 0.2, true)

puts "-- DiscNameNet, on names read off real discs --"
kk = first.(dname, fake(label: "DVD_VIDEO", name: "The Karate Kid (Special Edition)"))
check("edition dropped",       kk&.title, "The Karate Kid")
check("beats a label",         kk.confidence > 0.7, true)
ff = first.(dname, fake(label: "FIREFLYUS_D1", name: "FIREFLY: DISC 1", type: "bluray"))
check("FIREFLY: DISC 1 title", ff&.title, "Firefly")
check("FIREFLY: DISC 1 disc",  ff&.disc_number, 1)
check("mixed case survives",   first.(dname, fake(name: "eXistenZ"))&.title, "eXistenZ")
check("unknown parenthetical kept",
      first.(dname, fake(name: "Fanny (Hill)"))&.title, "Fanny (Hill)")

puts "-- ShapeNet, on real disc shapes --"
# The Karate Kid: one feature against ten extras.
kk_secs = [7608, 119, 225, 782, 497, 600, 1439, 1284, 126, 88, 64]
check("Karate Kid is a film", shape.classify(kk_secs.sort.reverse), "movie")
# Firefly disc 1: an 87-minute pilot against three 43-minute episodes. The
# ratio test alone calls this a film by a 1.3% margin; the remainder test saves
# it. This is the case the Go fix was written for.
ff_secs = [5202, 2638, 2634, 2563, 1719]
check("Firefly disc 1 is television", shape.classify(ff_secs), "series")

puts "-- Resolver --"
props = [
  Identify::CandidateProposal.new(net: "discname", title: "The Karate Kid", confidence: 0.8, why: "x"),
  Identify::CandidateProposal.new(net: "label",    title: "Karate Kid",     confidence: 0.5, why: "y")
]
r = Identify::Resolver.call(props)
check("different titles do not merge", r.all.size, 2)
agree = [
  Identify::CandidateProposal.new(net: "discname", title: "Roman Holiday", confidence: 0.6, why: "x"),
  Identify::CandidateProposal.new(net: "label",    title: "ROMAN_HOLIDAY", confidence: 0.5, why: "y")
]
ra = Identify::Resolver.call(agree)
check("agreeing nets merge",           ra.all.size, 1)
check("agreement raises confidence",   ra.best.confidence > 0.6, true)

# The winner is routinely the net that read the title off the disc, not the one
# that looked it up -- so the id has to survive the merge, or the NFO loses the
# only field that stops Jellyfin re-matching the file by its name.
carried = Identify::Resolver.call([
  Identify::CandidateProposal.new(net: "discname", title: "Roman Holiday", confidence: 0.9, why: "x"),
  Identify::CandidateProposal.new(net: "provider", title: "Roman Holiday", confidence: 0.85,
                                  year: 1953, provider: "tmdb", provider_id: "804", why: "y")
])
check("the leader keeps the provider id", carried.best.provider_id, "804")
check("and the provider's year",          carried.best.year, 1953)

puts "-- ProviderNet, against a stubbed TMDB --"
# A stub rather than the real API: the logic worth testing is how a match is
# judged, and that must be checkable with no key and no network.
class StubTmdb
  def initialize(movies) = (@movies = movies)
  def configured? = true
  def search_movie(_t, year: nil) = @movies
  def search_series(_t, year: nil) = []
end

kk_disc = fake(name: "The Karate Kid", secs: [7608, 119, 225])
props   = [Identify::CandidateProposal.new(net: "discname", title: "The Karate Kid", confidence: 0.8)]

# 7608s on the disc against a 126-minute listing: agrees within ~1%.
right = StubTmdb.new([{ provider: "tmdb", provider_id: "9607", title: "The Karate Kid",
                        year: 1984, runtime_seconds: 126 * 60 }])
c = Identify::ProviderNet.new(client: right).identify(kk_disc, props).first
check("runtime agreement raises confidence", c.confidence > 0.8, true)
check("provider proposes the year",          c.year, 1984)
check("why names the tmdb id",               c.why.include?("tmdb:9607"), true)

# The 2010 remake: same title, 140 minutes. Must be demoted, not accepted.
wrong = StubTmdb.new([{ provider: "tmdb", provider_id: "38575", title: "The Karate Kid",
                        year: 2010, runtime_seconds: 140 * 60 }])
w = Identify::ProviderNet.new(client: wrong).identify(kk_disc, props).first
check("runtime disagreement demotes it",     w.confidence < 0.5, true)
check("but it is still reported",            w.title, "The Karate Kid")

# No key at all is an ordinary answer, not a failure.
class NoKey; def configured? = false; end
check("unconfigured provider abstains",
      Identify::ProviderNet.new(client: NoKey.new).identify(kk_disc, props), [])

# The case the single-element stubs above could never reach.
#
# Every stub in this file used to return exactly one film, so "does the runtime
# check pick the right one" was never actually asked -- and the answer was no.
# Scoring ran over the results and then took whichever TMDB returned first,
# which is by popularity. A real search for "The Karate Kid" puts the 2010
# remake above the 1984 film, so the disc this project uses as its own worked
# example proposed the remake and never proposed the film it holds.
puts "-- ProviderNet, when the search returns more than one film --"
remake = { provider: "tmdb", provider_id: "38575", title: "The Karate Kid",
           year: 2010, runtime_seconds: 140 * 60 }
film   = { provider: "tmdb", provider_id: "9607", title: "The Karate Kid",
           year: 1984, runtime_seconds: 126 * 60 }

# Deliberately in the order TMDB actually returns them: the remake first.
both = Identify::ProviderNet.new(client: StubTmdb.new([remake, film]))
c = both.identify(kk_disc, props).first
check("runtime chooses the film, not the popular one", c.provider_id, "9607")
check("and it is not rejected",                        c.rejected?,   false)

# Where runtime cannot separate two results, TMDB's own ranking still decides.
twin = { provider: "tmdb", provider_id: "111", title: "The Karate Kid",
         year: 1984, runtime_seconds: 127 * 60 }
tie = Identify::ProviderNet.new(client: StubTmdb.new([twin, film]))
check("a tie keeps the provider's own ranking",
      tie.identify(kk_disc, props).first.provider_id, "111")

puts "-- Resolver, on a match its own net rejected --"
# A rejected proposal is testimony, not corroboration. It stays visible, but it
# must not raise the winner and must not fill in what the winner lacks -- which
# is the whole reason the runtime check exists, and which merging quietly undid.
named    = Identify::CandidateProposal.new(net: "discname", title: "The Karate Kid",
                                           confidence: 0.8, why: "read from the DVD text data manager")
demoted  = Identify::CandidateProposal.new(net: "provider", title: "The Karate Kid",
                                           year: 2010, provider: "tmdb", provider_id: "38575",
                                           confidence: 0.4, rejected: true,
                                           why: "runtime disagrees by 11%")
r = Identify::Resolver.call([named, demoted])
check("no agreement bonus from a rejected match", r.best.confidence, 0.8)
check("it donates no year",                       r.best.year,        nil)
check("it donates no provider id",                r.best.provider_id, nil)
check("but its reasoning survives",               r.best.why.include?("set aside"), true)

# An accepted match must still do all of those things.
agreed = Identify::CandidateProposal.new(net: "provider", title: "The Karate Kid",
                                         year: 1984, provider: "tmdb", provider_id: "9607",
                                         confidence: 0.85, why: "runtime agrees within 1%")
r2 = Identify::Resolver.call([named, agreed])
check("an accepted match still corroborates", r2.best.confidence > 0.85, true)
check("and still supplies the id",            r2.best.provider_id, "9607")

puts "-- The whole chain, on the disc that got this wrong --"
# Mirrors IdentifyDisc: the disc-reading nets, then the provider over what they
# found, then resolution. IdentifyDisc::NETS is the source of truth for the
# list; it is repeated here because loading that file would drag in ActiveRecord
# and this script deliberately runs without a database.
DISC_NETS = [Identify::DiscNameNet, Identify::LabelNet, Identify::ShapeNet].freeze
def chain(disc, tmdb)
  proposals = DISC_NETS.flat_map { |k| k.new.identify(disc) }
  proposals += Identify::ProviderNet.new(client: tmdb).identify(disc, proposals)
  Identify::Resolver.call(proposals)
end

# Volume label DVD_VIDEO, so the label net abstains and the disc's own name is
# all there is. 7608s of feature against TMDB's 126 minutes.
kk = fake(label: "DVD_VIDEO", name: "The Karate Kid (Special Edition)", secs: [7608, 225, 119])

good = chain(kk, StubTmdb.new([remake, film]))
check("the right film wins",           good.best.provider_id, "9607")
check("with the right year",           good.best.year,        1984)
check("classified from its shape",     good.best.kind,        "movie")
check("and it is auto-confirmed",
      Identify::Decision.status(good, current: "rough"), "confirmed")

# Now the same disc where TMDB offers only the remake. Before the fix this
# merged to 0.95, adopted year 2010 and tmdb:38575, and filed itself.
only_remake = chain(kk, StubTmdb.new([remake]))
check("a rejected match cannot reach 0.95", only_remake.best.confidence < 0.95, true)
check("nor donate the wrong year",          only_remake.best.year,        nil)
check("nor the wrong tmdb id",              only_remake.best.provider_id, nil)
check("the name off the disc still stands", only_remake.best.title, "The Karate Kid")

puts "-- Decision: what may reach the library unseen --"
# A film is only auto-confirmed with a provider id. Confidence says how sure
# the nets are about the name; the id says whether the name is worth writing
# into a directory Jellyfin will read. They are different questions and the
# second is a missing field, not a low score.
def outcome(**kw)
  best = Identify::CandidateProposal.new(**{ net: "discname", title: "The Karate Kid",
                                             kind: "movie", confidence: 0.9 }.merge(kw))
  Identify::Decision.status(
    Identify::Resolver::Result.new(best: best, all: [best], contested: false),
    current: "rough"
  )
end

check("a film with a provider id confirms",
      outcome(provider: "tmdb", provider_id: "9607"), "confirmed")
check("a confident film without one does not",
      outcome, "needs_review")
check("an empty provider id counts as none",
      outcome(provider_id: ""), "needs_review")
check("low confidence still goes to review",
      outcome(provider_id: "9607", confidence: 0.5), "needs_review")
check("a series always goes to review",
      outcome(provider_id: "9607", kind: "series"), "needs_review")
# FileDisc refuses a disc with no kind, so confirming one only parks it
# somewhere the dashboard never shows.
check("no kind goes to review rather than being parked",
      outcome(provider_id: "9607", kind: nil), "needs_review")
# A person's decision is never dragged backwards by a re-run.
check("an already-confirmed disc is left alone",
      Identify::Decision.status(
        Identify::Resolver::Result.new(best: nil, all: [], contested: true),
        current: "confirmed"
      ), "confirmed")

# And the whole chain, on the disc this all started with.
check("Karate Kid confirms when TMDB is reachable",
      Identify::Decision.status(good, current: "rough"), "confirmed")
check("and waits for a person when the only match was rejected",
      Identify::Decision.status(only_remake, current: "rough"), "needs_review")

puts(($failures.zero? ? "\nall checks passed" : "\n#{$failures} FAILED"))
exit($failures.zero? ? 0 : 1)
